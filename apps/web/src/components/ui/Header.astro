---
import clsx from "clsx"
import { metadata } from "../../lib/metadata"

interface HeaderLink {
  text: string
  to: string
  forceActive?: boolean
}

interface Props {
  links: HeaderLink[]
  /** Current page path, used for the active-link underline. */
  currentPath: string
}

const { links, currentPath } = Astro.props
const { displayTitle, weddingDate, location } = metadata

/** Gatsby Link's isCurrent || isPartiallyCurrent. */
function isActive(to: string, path: string) {
  const strip = (p: string) => p.replace(/\/+$/, "") || "/"
  const t = strip(to)
  const p = strip(path)
  return p === t || p.startsWith(`${t}/`)
}
---

<header
  class="sticky top-0 z-10 border-b h-bg-colors border-subtle sm:static sm:z-0 dark:border-subtle-night print:static"
>
  <div class="relative">
    <div class="py-3 text-center sm:pt-4 sm:pb-2">
      <h1 class="font-script font-bold text-3xl sm:text-4xl">
        <a href="/" class="px-1 c-link-focus">
          {displayTitle}
        </a>
      </h1>
      <h2 class="font-serif text-sm sm:text-lg">
        {weddingDate} &middot; {location}
      </h2>
    </div>
    <div class="absolute top-0 right-0 mx-2 h-full flex items-center sm:hidden print:hidden">
      <button
        id="menu-button"
        class="p-2 flex flex-col items-center justify-center c-link-focus h-bg-colors"
        type="button"
        aria-label="Toggle Menu"
        aria-controls="main-nav"
        aria-expanded="false"
      >
        <svg
          class="w-5 h-5 fill-current"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 20 20"
          aria-hidden="true"
        >
          <path d="M0 3h20v2H0V3zm0 6h20v2H0V9zm0 6h20v2H0v-2z"></path>
        </svg>
        <span class="font-sans text-xs w-full">Menu</span>
      </button>
    </div>
  </div>
  <nav
    id="main-nav"
    class="invisible border-subtle h-bg-colors h-fg-colors absolute w-full z-10 border-b font-sans font-semibold text-sm shadow-lg dark:border-subtle-night sm:shadow-none sm:static sm:visible sm:w-auto sm:border-b-0 sm:text-base print:hidden"
  >
    <ul
      class="pt-3 pb-4 shadow-inner border-t border-subtle dark:border-subtle-night sm:py-0 sm:flex sm:justify-center sm:items-center sm:border-t-0 sm:shadow-none dark:bg-background-secondary-night sm:dark:bg-transparent"
    >
      {
        links.map((link) => (
          <li class="text-center sm:mx-1 md:mx-2">
            <a
              href={link.to}
              class={clsx(
                "inline-block px-1 pt-4 pb-1 border-b-4 focus-visible:outline-hidden focus-visible:border-accent-focus/90 hover:border-accent-hover hover:text-accent-hover dark:focus-visible:border-accent-focus-night dark:hover:text-accent-hover-night dark:hover:border-accent-hover-night sm:px-2 sm:pt-3 sm:pb-2 sm:border-b-4",
                isActive(link.to, currentPath) || link.forceActive ? "border-accent" : "border-transparent"
              )}
            >
              {link.text}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  // Mobile menu: bundled by Astro, runs as a deferred module (before `load`).
  const button = document.getElementById("menu-button")
  const nav = document.getElementById("main-nav")

  if (button && nav) {
    let open = false
    const setOpen = (next: boolean) => {
      open = next
      nav.classList.toggle("visible", next)
      nav.classList.toggle("invisible", !next)
      button.setAttribute("aria-expanded", String(next))
    }

    button.addEventListener("click", () => setOpen(!open))

    // Close on a press outside both the button and the nav.
    const closeOnOutsidePress = (event: Event) => {
      const target = event.target as Node | null
      if (open && target && !button.contains(target) && !nav.contains(target)) {
        setOpen(false)
      }
    }
    document.addEventListener("mousedown", closeOnOutsidePress)
    document.addEventListener("touchstart", closeOnOutsidePress, { passive: true })

    // Close after following (or tapping) a nav link.
    for (const link of nav.querySelectorAll("a")) {
      link.addEventListener("click", () => setOpen(false))
    }
  }
</script>
