---
import { Picture } from "astro:assets"
import whereAmI from "../images/where-am-i.jpg"
import BaseLayout from "../layouts/BaseLayout.astro"
import { pictureFormats } from "../lib/picture"
---

<BaseLayout title="Not Found">
  <main class="flex p-3 mx-auto justify-center items-center max-w-lg min-h-screen">
    <div class="c-shadow-box">
      <h1 class="text-3xl font-sans mb-2">Oops!</h1>
      <div class="c-article-text-container">
        <p>
          We couldn&rsquo;t find that page. No worries: we can continue our celebrations on the <a href="/">homepage</a>!
        </p>
      </div>
      <Picture
        src={whereAmI}
        alt="Milind looking away in the distance, confused."
        width={576}
        layout="constrained"
        formats={pictureFormats}
        fallbackFormat="jpg"
        class="w-full"
        style={`aspect-ratio: ${whereAmI.width} / ${whereAmI.height}`}
      />
    </div>
  </main>
</BaseLayout>
