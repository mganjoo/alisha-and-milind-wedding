{
  "name": "@am-wedding/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0 --port 9000",
    "preview:test": "rm -rf .wrangler/e2e-state && wrangler d1 migrations apply DB --local --persist-to .wrangler/e2e-state && wrangler dev --local --persist-to .wrangler/e2e-state --ip 0.0.0.0 --port 9000",
    "db:migrate:local": "wrangler d1 migrations apply DB --local -c wrangler.jsonc",
    "check:types": "astro check && tsc -p test --noEmit",
    "test:unit": "vitest run && vitest run -c test/vitest.config.ts",
    "import-guests": "node --experimental-strip-types scripts/import-guests.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.9",
    "@astrojs/markdown-satteri": "0.4.10",
    "@astrojs/react": "7.1.9",
    "@fontsource-variable/eb-garamond": "5.3.0",
    "@fontsource-variable/raleway": "5.3.0",
    "@fontsource/tangerine": "5.3.0",
    "@hookform/resolvers": "7.0.9",
    "@react-spring/web": "10.1.2",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/vite": "4.3.5",
    "astro": "7.4.13",
    "clsx": "2.1.1",
    "dayjs": "1.11.23",
    "drizzle-orm": "0.45.4",
    "idb-keyval": "6.3.0",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@cloudflare/vitest-plugin": "1.9.2",
    "@cloudflare/workers-types": "5.20261125.1",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "24.19.4",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.2",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "jsdom": "31.0.1",
    "nanoid": "6.0.2",
    "papaparse": "5.7.1",
    "typescript": "5.9.3",
    "vitest": "5.1.1",
    "wrangler": "4.168.0"
  }
}
