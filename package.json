{
  "name": "alisha-and-milind-wedding",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @am-wedding/web dev",
    "build": "pnpm --filter @am-wedding/web build",
    "check": "biome check . && pnpm -r --if-present check:types",
    "format": "biome format --write .",
    "test:unit": "pnpm -r --if-present test:unit",
    "test:e2e": "pnpm --filter @am-wedding/e2e test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "typescript": "5.9.3"
  }
}
